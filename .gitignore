node_modules/
packages/*/lib/
features/lib/
lib-test/
dist/
coverage/
*.tsbuildinfo
.turbo/
.DS_Store
*.log
features/reports/
.env
.env.*
!.env.example

.doc-examples/
.website-doc-examples/
.package-check/
reports/
.stryker-tmp/
.scratch/

# Astro's generated type-declaration cache
apps/*/.astro/

# Compiled test output, which once got committed beside its source
packages/*/test/**/*.js
packages/*/test/**/*.js.map
packages/*/test/**/*.d.ts
packages/*/test/**/*.d.ts.map

# @qadi/predicate-prisma's fixture schema is committed; what `prisma
# generate`/`db push` produce from it is not.
packages/predicate-prisma/prisma/generated/
packages/predicate-prisma/prisma/*.db

# Local assistant/tooling state, never meant to be shared or diffed.
.claude/
.impeccable/

# `.planning/` is otherwise tracked on purpose (its planning documents are
# real project history) — this is the one file in it that is not: a live
# session id, PID and timestamp, one `git add -A` away from being committed
# as if it were content.
.planning/milestone.lock
