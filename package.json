{
  "name": "qadi-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Mohammad AL Mechkor",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/leaderiop/qadi.git"
  },
  "packageManager": "pnpm@10.17.1",
  "description": "Effect-native authorization: permission tokens, role DAG, schema-derived policy ADT, Effect evaluator",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "changeset": "changeset",
    "changeset-version": "changeset version",
    "changeset-publish": "changeset publish",
    "clean": "tsc -b --clean && rm -rf packages/*/lib",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck",
    "test:tstyche": "tstyche",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "mutation": "stryker run && stryker run stryker.devtools.mjs && stryker run stryker.predicate-sql.mjs && stryker run stryker.predicate-prisma.mjs && stryker run stryker.audit.mjs",
    "test:bdd": "pnpm --filter @qadi/features test",
    "circular": "madge --circular --extensions ts,tsx packages/*/src",
    "lint": "oxlint && node scripts/check-house-style.mjs",
    "lint:fix": "oxlint --fix",
    "lint:style": "node scripts/check-house-style.mjs",
    "format": "oxfmt packages features",
    "format:check": "oxfmt --check packages features",
    "spec:verify": "bash spec/scripts/verify-traceability.sh",
    "spec:verify:strict": "bash spec/scripts/verify-traceability.sh --strict",
    "check": "pnpm typecheck && pnpm lint && pnpm circular && pnpm test:tstyche && pnpm coverage && pnpm test:bdd && pnpm spec:examples && pnpm spec:verify:strict && pnpm spec:gates && pnpm spec:claims && pnpm spec:api && pnpm spec:package && pnpm example && pnpm mutation",
    "spec:examples": "node scripts/check-doc-examples.mjs",
    "spec:api": "node scripts/check-api-surface.mjs",
    "spec:package": "node scripts/check-package-install.mjs",
    "spec:gates": "node scripts/check-dod-table.mjs",
    "spec:claims": "node scripts/check-devtools-claims.mjs",
    "example": "pnpm --filter @qadi/example-nextjs check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@effect/language-service": "^0.77.0",
    "@effect/vitest": "catalog:",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "madge": "^8.0.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "react": "catalog:",
    "tstyche": "^7.2.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
