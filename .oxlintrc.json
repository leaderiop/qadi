{
  "rules": {
    "require-yield": "off",
    "no-misused-new": "off",
    "no-non-null-asserted-optional-chain": "off",
    "no-explicit-any": "error"
  },
  "ignorePatterns": [
    "packages/*/lib/**",
    "features/lib/**",
    "**/lib-test/**",
    "**/node_modules/**",
    "apps/*/.astro/**",
    "apps/*/dist/**"
  ]
}
