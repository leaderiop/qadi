{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./lib/.tsbuildinfo",
    "types": ["node", "react"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [{ "path": "../core/tsconfig.src.json" }]
}
