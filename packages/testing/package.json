{
  "name": "@qadi/testing",
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "author": "Mohammad AL Mechkor",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/leaderiop/qadi.git",
    "directory": "packages/testing"
  },
  "description": "Test layers, fixtures, conformance suites and matchers for @qadi/core",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "import": "./lib/*.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@qadi/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
