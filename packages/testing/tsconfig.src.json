{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@qadi/core": [
        "../../packages/core/src/index.ts"
      ],
      "@qadi/testing": [
        "../../packages/testing/src/index.ts"
      ]
    }
  },
  "references": [
    {
      "path": "../core/tsconfig.src.json"
    }
  ]
}
