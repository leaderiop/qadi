{
  "name": "@qadi/predicate-prisma",
  "version": "0.11.1",
  "type": "module",
  "license": "MIT",
  "author": "Mohammad AL Mechkor",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/leaderiop/qadi.git",
    "directory": "packages/predicate-prisma"
  },
  "homepage": "https://github.com/leaderiop/qadi/tree/main/packages/predicate-prisma#readme",
  "bugs": {
    "url": "https://github.com/leaderiop/qadi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Compiles a @qadi/core Predicate to a Prisma WhereInput",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "import": "./lib/*.js",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "prepack": "pnpm -w run build",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 CHECKPOINT_DISABLE=1 prisma generate"
  },
  "dependencies": {
    "@qadi/core": "workspace:^"
  },
  "peerDependencies": {
    "effect": "catalog:peer"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "better-sqlite3": "12.11.1",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "prisma": "7.10.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "authorization",
    "prisma",
    "row-level-security",
    "qadi"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
