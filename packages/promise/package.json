{
  "name": "@qadi/promise",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "A Promise-returning facade over @qadi/core, for callers who do not use Effect",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "import": "./lib/*.js"
    }
  },
  "files": ["lib", "src"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@qadi/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": ["authorization", "promise", "async", "qadi"]
}
