{
  "name": "@qadi/core",
  "version": "0.6.1",
  "type": "module",
  "license": "MIT",
  "author": "Mohammad AL Mechkor",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/leaderiop/qadi.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/leaderiop/qadi/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/leaderiop/qadi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Effect-native authorization: permission tokens, role DAG, schema-derived policy ADT, Effect evaluator",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "import": "./lib/*.js",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "prepack": "pnpm -w run build",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "effect",
    "authorization",
    "rbac",
    "abac",
    "rebac",
    "policy",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
